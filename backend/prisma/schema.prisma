generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                 @id @default(cuid())
  employeeId              String
  companyName             String
  fullName                String?
  email                   String?
  phone                   String?
  address                 String?
  profileImage            String?
  gender                  String?
  department              String?
  designation             String?
  joiningDate             DateTime?
  employmentType          String?
  employmentStatus        String                 @default("active")
  defaultSiteId           String?
  defaultShiftId          String?
  basicSalary             Int                    @default(0)
  salaryAllowances        Int                    @default(0)
  salaryBonus             Int                    @default(0)
  salaryTax               Int                    @default(0)
  salaryProvidentFund     Int                    @default(0)
  salaryType              String                 @default("monthly")
  emergencyContactName    String?
  emergencyContactPhone   String?
  emergencyContactAddress String?
  passwordHash            String
  role                    String
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  sessions                RefreshSession[]
  attendances             Attendance[]
  leaveRequests           LeaveRequest[]
  salaryPayments          SalaryPayment[]
  salaryAdvances          SalaryAdvanceRequest[]
  loanRequests            LoanRequest[]
  loans                   Loan[]
  tasks                   Task[]
  projectAssignments      ProjectAssignment[]
  documents               EmployeeDocument[]
  announcementReads       AnnouncementRead[]
  hrChatConversations     HrChatConversation[]
  defaultSite             Site?                  @relation(fields: [defaultSiteId], references: [id], onDelete: SetNull)
  defaultShift            Shift?                 @relation(fields: [defaultShiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, companyName])
  @@unique([email, companyName])
  @@index([role])
  @@index([defaultSiteId])
  @@index([defaultShiftId])
}

model HrChatConversation {
  id        String          @id @default(cuid())
  userId    String
  title     String          @default("New conversation")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  HrChatMessage[]

  @@index([userId, updatedAt])
}

model HrChatMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime           @default(now())
  conversation   HrChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  content     String
  priority    String             @default("normal")
  isPinned    Boolean            @default(false)
  isActive    Boolean            @default(true)
  publishedAt DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  reads       AnnouncementRead[]

  @@index([isPinned, publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  userId         String
  announcementId String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId, readAt])
}

model EmployeeDocument {
  id           String    @id @default(cuid())
  userId       String
  name         String
  fileUrl      String
  fileType     String
  size         Int
  status       String    @default("pending")
  reviewerNote String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Project {
  id          String              @id @default(cuid())
  name        String
  description String?
  status      String              @default("active")
  progress    Int                 @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments ProjectAssignment[]

  @@index([status])
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("Contributor")
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  priority    String    @default("medium")
  status      String    @default("todo")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([dueDate])
}

model SalaryPayment {
  id            String    @id @default(cuid())
  userId        String
  month         String
  period        String
  paidOn        DateTime?
  basic         Int
  allowances    Int       @default(0)
  bonus         Int       @default(0)
  tax           Int       @default(0)
  providentFund Int       @default(0)
  status        String    @default("upcoming")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, status])
}

model SalaryAdvanceRequest {
  id              String    @id @default(cuid())
  userId          String
  amount          Int
  reason          String
  settlementMonth String
  status          String    @default("pending")
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model LoanRequest {
  id         String    @id @default(cuid())
  userId     String
  amount     Int
  purpose    String
  tenure     Int
  status     String    @default("pending")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan       Loan?

  @@index([userId, status])
}

model Loan {
  id               String      @id @default(cuid())
  userId           String
  requestId        String      @unique
  principal        Int
  outstanding      Int
  installment      Int
  tenure           Int
  paidInstallments Int         @default(0)
  nextDue          DateTime
  status           String      @default("active")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  request          LoanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Site {
  id                  String       @id @default(cuid())
  name                String       @unique
  location            String
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  checkInAttendances  Attendance[] @relation("CheckInSite")
  checkOutAttendances Attendance[] @relation("CheckOutSite")
  employees           User[]
}

model Shift {
  id                  String       @id @default(cuid())
  name                String       @unique
  startTime           String
  endTime             String
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  checkInAttendances  Attendance[] @relation("CheckInShift")
  checkOutAttendances Attendance[] @relation("CheckOutShift")
  employees           User[]
}

model Attendance {
  id               String    @id @default(cuid())
  userId           String
  checkInSiteId    String
  checkInShiftId   String
  checkInAt        DateTime  @default(now())
  checkInPhotoUrl  String
  checkOutSiteId   String?
  checkOutShiftId  String?
  checkOutAt       DateTime?
  checkOutPhotoUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInSite      Site      @relation("CheckInSite", fields: [checkInSiteId], references: [id])
  checkOutSite     Site?     @relation("CheckOutSite", fields: [checkOutSiteId], references: [id])
  checkInShift     Shift     @relation("CheckInShift", fields: [checkInShiftId], references: [id])
  checkOutShift    Shift?    @relation("CheckOutShift", fields: [checkOutShiftId], references: [id])

  @@index([userId, checkOutAt])
  @@index([checkInAt])
}

model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  leaveType String
  reason    String
  startDate DateTime
  endDate   DateTime
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([startDate])
}

model RefreshSession {
  id         String    @id @default(cuid())
  tokenId    String    @unique
  userId     String
  rememberMe Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
